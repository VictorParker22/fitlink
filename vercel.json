{
  "buildCommand": "npm run build",
  "functions": {
    "api/coach-meta/*.js": { "includeFiles": "dist/spa.html", "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/pricing", "destination": "/prerendered/pricing.html" },
    { "source": "/athletes", "destination": "/prerendered/athletes.html" },
    { "source": "/support", "destination": "/prerendered/support.html" },
    {
      "source": "/c/:handle",
      "has": [{ "type": "query", "key": "spa" }],
      "destination": "/spa.html"
    },
    {
      "source": "/c/:handle",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|meta-externalagent|meta-externalfetcher|Twitterbot|Slackbot|Slack-ImgProxy|Discordbot|WhatsApp|TelegramBot|LinkedInBot|Pinterestbot|redditbot|Applebot|Googlebot|Google-InspectionTool|bingbot|BingPreview|DuckDuckBot|YandexBot|Embedly|SkypeUriPreview|vkShare|Iframely|Mastodon|Bluesky|Snap URL Preview).*" }],
      "destination": "/api/coach-meta/:handle"
    },
    {
      "source": "/((?!api/|\\.well-known/apple-app-site-association$).*)",
      "destination": "/spa.html"
    }
  ]
}
