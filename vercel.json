{
  "rewrites": [
    {
      "source": "/delete-account",
      "destination": "/delete-account.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/((?!privacy\\.html$|delete-account\\.html$).*)",
      "destination": "/index.html"
    }
  ]
}
